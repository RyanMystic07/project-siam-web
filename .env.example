# Railway PostgreSQL — auto-injected เมื่อ add PostgreSQL service บน Railway
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Token สำหรับ POST /api/announcements — สร้างเองด้วย random string ยาวๆ
ADMIN_TOKEN=your-secret-admin-token-here

# Port — Railway inject ให้อัตโนมัติ ไม่ต้องตั้งเอง
PORT=3000
