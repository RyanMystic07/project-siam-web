{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-siam-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
  // Hyperdrive binding เพิ่มทีหลังเมื่อ Railway DB พร้อม:
  // "hyperdrive": [
  //   { "binding": "DB", "id": "<HYPERDRIVE_ID>" }
  // ]
}
