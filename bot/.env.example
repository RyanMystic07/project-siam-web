# Railway PostgreSQL — auto-injected เมื่อ add PostgreSQL service บน Railway
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Discord Bot Token — จาก Discord Developer Portal > Bot > Token
DISCORD_TOKEN=your-discord-bot-token-here

# Channel ID ที่จะโพสต์ announcement — คลิกขวา channel > Copy Channel ID
DISCORD_CHANNEL_ID=000000000000000000

# ความถี่ตรวจ DB หน่วย ms (default 5 นาที = 300000)
POLL_INTERVAL_MS=300000
